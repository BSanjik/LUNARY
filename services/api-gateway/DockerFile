# Dockerfile для API Gateway (Go)
FROM golang:1.24 AS builder

WORKDIR /app/api-gateway

# Копируем структуру проекта
COPY api-gateway/go.mod api-gateway/go.sum ./
COPY common ../common
RUN go mod download

# Копируем исходники
COPY api-gateway .

# Собираем бинарник
RUN go build -o api-gateway ./cmd

# Финальный образ
FROM alpine:latest

RUN apk --no-cache add ca-certificates curl libc6-compat

WORKDIR /app

# Копируем бинарник
COPY --from=builder /app/api-gateway/api-gateway .
RUN chmod +x ./api-gateway

# Устанавливаем порт
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Запуск
CMD ["./api-gateway"]